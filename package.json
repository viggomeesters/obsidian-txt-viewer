{
  "name": "obsidian-txt-viewer",
  "version": "0.1.0",
  "description": "Read-only TXT viewer plugin with line numbers, search navigation, filtering, and large-file guards.",
  "main": "main.js",
  "scripts": {
    "build": "NODE_ENV=production node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs",
    "test": "node scripts/text-test.mjs && node scripts/smoke-test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "obsidian",
    "txt",
    "viewer",
    "text",
    "read-only"
  ],
  "author": "Viggo Meesters",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.25.12",
    "obsidian": "^1.8.7",
    "typescript": "^5.9.3"
  },
  "dependencies": {}
}
