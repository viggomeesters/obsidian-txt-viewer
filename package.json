{
  "name": "obsidian-txt-viewer",
  "version": "0.1.2",
  "description": "Read-only TXT viewer plugin with line numbers, search navigation, filtering, and large-file guards.",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "node scripts/text-test.mjs && node scripts/smoke-test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "keywords": [
    "obsidian",
    "txt",
    "viewer",
    "text",
    "read-only"
  ],
  "author": "Viggo Meesters",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.25.12",
    "eslint": "9.39.4",
    "eslint-plugin-obsidianmd": "0.6.0",
    "obsidian": "1.14.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
